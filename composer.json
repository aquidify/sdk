{
    "name": "aquidify/sdk",
    "description": "PHP client for the Aquidify API, with a Laravel adapter: turn what people type into validated, structured intent.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "aquidify",
        "intent",
        "nlp",
        "structured output",
        "api",
        "sdk",
        "laravel"
    ],
    "homepage": "https://aquidify.com",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Aquidify\\": "php/src/"
        }
    },
    "scripts": {
        "test": [
            "phpunit php/tests/Laravel",
            "php php/tests/smoke.php"
        ]
    },
    "suggest": {
        "illuminate/support": "Laravel adapter: config, auto-discovered service provider, Aquidify facade and Aquidify::fake() (^11.0|^12.0|^13.0)"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Aquidify\\Tests\\": "php/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aquidify\\Laravel\\AquidifyServiceProvider"
            ],
            "aliases": {
                "Aquidify": "Aquidify\\Laravel\\Facades\\Aquidify"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
